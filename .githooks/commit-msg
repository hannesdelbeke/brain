#!/bin/sh
# brain commit-msg. Active only when core.hooksPath is set to .githooks.
#
# The 2026-09-01 scrub found seven commit messages carrying a private term,
# two of them in the subject line, while every file at the tip was clean --
# git filter-repo's --replace-text does not touch messages and git log -S
# cannot see them. Messages get the same gate as content.

[ -n "$PKM_ALLOW_LEAK_TERM" ] && exit 0

PY=$(command -v python || command -v python3)
if [ -z "$PY" ]; then
  echo "commit-msg: python not found, cannot run the private-term scan." >&2
  echo "Install python, or bypass with: PKM_ALLOW_LEAK_TERM=1 git commit ..." >&2
  exit 1
fi

exec "$PY" .githooks/leak_scan.py --message "$1"
